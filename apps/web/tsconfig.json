{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ⚠️ Base'in DÖRT ayarı burada EZİLMEK ZORUNDA; hiçbiri tercih değil:
    //  • module/moduleResolution: base NodeNext — göreli importlarda `.js`
    //    uzantısı dayatır, JSX dosyalarında anlamsız.
    //  • lib: base'de DOM YOK; `document` bile tanınmaz.
    //  • declaration/decorators: Next hiçbirini istemiyor.
    //  • incremental: base tsbuildinfo'yu `dist/`e yazar. `noEmit: true` olmasına
    //    RAĞMEN apps/web/dist/ doğar ve turbo'nun `dist/**` çıktısıyla eşleşerek
    //    SAHTE bir önbellek isabeti üretir — build atlanır, kimse fark etmez.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "incremental": false,

    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", ".turbo"]
}
