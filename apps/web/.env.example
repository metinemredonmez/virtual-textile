# apps/web ortam değişkenleri.
#
# ⚠️ Kök .env BURADAN OKUNMAZ. Next kendi uygulama dizinindeki .env dosyalarını
#    yükler. Bu bilinçli: frontend süreci backend'in sırlarını (JWT_*, IYZICO_*,
#    FIELD_ENCRYPTION_KEY) GÖRMEMELİ. Görmediği şeyi paketine gömemez.

API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Web oturum deposu. Backend'in REDIS_URL'iyle aynı örnek olabilir.
SESSION_REDIS_URL=redis://localhost:6380

# Türetilmiş Idempotency anahtarlarının tuzu (openssl rand -hex 32).
# ⚠️ Tahmin edilebilir anahtar başkasının idempotency kaydına çarpar.
SESSION_SECRET=degistir-openssl-rand-hex-32

# ── Medya kökü ─────────────────────────────────────────────────────────────
#
# ⚠️ BU DEĞER r2.dev'İ GÖSTERİYORDU VE ÖLÇÜLEREK DEĞİŞTİRİLDİ (2026-08-13).
#
#    `https://pub-<hash>.r2.dev` Cloudflare'in GELİŞTİRME adresidir. Ölçüm,
#    aynı makineden, aynı anahtara:
#        DNS  → 4 kayıt, çözülüyor            ✓
#        TCP  → :443 bağlanıyor               ✓
#        GET  → 8 istekte 8 zaman aşımı       ✗   (curl rc=28)
#        cloudflare.com aynı anda 200         → ağ sorunu DEĞİL
#        R2'nin S3 ucu aynı anda 400          → kova AYAKTA, nesneler yerinde
#    Yani TCP kuruluyor, TLS EL SIKIŞMASI düşürülüyor. Ana sayfadaki 49
#    görselin neredeyse tamamı bu yüzden kırık geliyordu.
#
# YENİ KÖK: `/v1/media` — kendi API'miz. Nesneyi R2'nin S3 API'sinden okuyup
# kendisi veriyor (bkz. `apps/api/.../media-public.controller.ts`). S3 ucu aynı
# geliştirme sınırına tabi değil; seed 278 görseli oraya sorunsuz yükledi.
#
# ÜRETİMDE: `/etc/virtual-textile/web.env` içinde
#     NEXT_PUBLIC_MEDIA_URL=http://91.99.183.64/medya
# yazar. nginx `/medya/` bloğu artık r2.dev'i değil BİZİM API'mizi vekilliyor ve
# önbelleğe alıyor (infra/nginx/vt.conf). Yani tarayıcı → nginx (önbellek) →
# API → R2 S3. Ölçümler: docs/medya-dagitimi.md
#
# ⚠️ ÜRETİMDE ADRES MUTLAK OLMALI. Göreli `/medya` yazmak SESSİZCE kırar:
#    Next `/` ile başlayan `src`i YEREL sayıp kendi istek işleyicisine
#    yönlendirir, nginx'i hiç görmez → 404.
#
# ⚠️ Bu değer `next.config.ts` içinde `images.remotePatterns`e ÇEVRİLİYOR;
#    ikinci bir yerde elle güncellemek gerekmez. Ama derleme zamanında
#    okunur — değiştirdiyseniz `next build` şart, PM2 restart yetmez.
NEXT_PUBLIC_MEDIA_URL=http://localhost:3001/v1/media
