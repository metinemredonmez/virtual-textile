# apps/web ortam değişkenleri.
#
# ⚠️ Kök .env BURADAN OKUNMAZ. Next kendi uygulama dizinindeki .env dosyalarını
#    yükler. Bu bilinçli: frontend süreci backend'in sırlarını (JWT_*, IYZICO_*,
#    FIELD_ENCRYPTION_KEY) GÖRMEMELİ. Görmediği şeyi paketine gömemez.

API_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Web oturum deposu. Backend'in REDIS_URL'iyle aynı örnek olabilir.
SESSION_REDIS_URL=redis://localhost:6380

# Türetilmiş Idempotency anahtarlarının tuzu (openssl rand -hex 32).
# ⚠️ Tahmin edilebilir anahtar başkasının idempotency kaydına çarpar.
SESSION_SECRET=degistir-openssl-rand-hex-32

# Ürün görsellerinin genel kökü (R2_PUBLIC_URL ile aynı).
NEXT_PUBLIC_MEDIA_URL=https://pub-7fbed3fcd71b47f79a9a44b6fb43f91b.r2.dev
