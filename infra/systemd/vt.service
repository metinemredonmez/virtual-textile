# PM2'yi systemd altında çalıştırır.
#
# `pm2 startup` ile üretilen resurrect tabanlı birim yerine pm2-runtime
# kullanılıyor: süreç ön planda çalışır, systemd gerçek durumu görür,
# "pm2 kaydedilmiş listeyi hatırlamadı" sınıfı sorunlar oluşmaz.
#
# Kurulum:
#   sudo cp infra/systemd/vt.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vt
#
# Kesintisiz yeniden yükleme (systemd'yi durdurmadan):
#   sudo -u vt pm2 reload vt-api

[Unit]
Description=Virtual Textile — API (PM2)
Documentation=https://github.com/metinemredonmez/virtual-textile
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=vt
Group=vt
WorkingDirectory=/var/www/virtual

# Ortam değişkenleri dosyadan okunur; repoda değil, sunucuda durur.
# chmod 600, sahibi vt. Bkz. docs/secrets.md
EnvironmentFile=/etc/virtual-textile/api.env
Environment=NODE_ENV=production
Environment=PM2_HOME=/var/www/virtual/.pm2

ExecStart=/usr/local/bin/pm2-runtime start ecosystem.config.cjs --env production
ExecReload=/usr/local/bin/pm2 reload all

Restart=always
RestartSec=5
# Sürekli çöküyorsa sonsuz döngüye girme — 5 dakikada 5 denemeden fazlası durdurur.
StartLimitIntervalSec=300
StartLimitBurst=5

# Kapanırken açık istekleri tamamlamaya izin ver.
KillSignal=SIGINT
TimeoutStopSec=30

# ── Sıkılaştırma ──
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Yazılabilir tek yerler
ReadWritePaths=/var/www/virtual/.pm2 /var/log/virtual-textile
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
