# ══════════════════════════════════════════════════════════════════════════
#  virtual-textile — ortam değişkenleri
#  Bu dosyayı `.env` olarak kopyala ve gerçek değerleri gir.
#  ⚠️  .env ASLA commit edilmez.  Anahtar sahipliği için docs/secrets.md'ye bak.
# ══════════════════════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=debug
PORT=3001

# Genel
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# ── Veritabanı ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://vt:vt@localhost:5433/virtual_textile?schema=public

# ── Redis (cache + kuyruk + rate limit) ──────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Kimlik ────────────────────────────────────────────────────────────────
# Üret:  openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_HEX_MINIMUM_______________________________________
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_HEX_MINIMUM______________________________________
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Alan bazlı şifreleme (IBAN, vergi no) — üret: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_EXACTLY___________________________________

# ── Google OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Ödeme: iyzico Pazaryeri ──────────────────────────────────────────────
# Sandbox: https://sandbox-api.iyzipay.com | Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_WEBHOOK_SECRET=

# ── Nesne depolama: Cloudflare R2 (S3 uyumlu) ────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=vt-public-products
R2_BUCKET_PRIVATE=vt-private-user-photos
R2_PUBLIC_URL=http://localhost:9000/vt-public-products

# ── AI sağlayıcıları ─────────────────────────────────────────────────────
# Birincil try-on
FAL_KEY=
FAL_TRYON_MODEL=fal-ai/idm-vton
# Yedek try-on + görsel etiketleme
GOOGLE_AI_API_KEY=
GOOGLE_AI_IMAGE_MODEL=gemini-2.5-flash-image
# Stil danışmanı LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── AI bütçe guardrail'leri (Bölüm 10.7) ─────────────────────────────────
AI_DAILY_BUDGET_USD=50
AI_MONTHLY_BUDGET_USD=1200
AI_TRYON_DAILY_PER_USER=10
AI_TRYON_DAILY_PER_GUEST=2
AI_STYLIST_DAILY_PER_USER=30

# ── Bildirim ──────────────────────────────────────────────────────────────
NETGSM_USER=
NETGSM_PASS=
NETGSM_HEADER=
RESEND_API_KEY=
MAIL_FROM=noreply@example.com

# ── Kargo ─────────────────────────────────────────────────────────────────
SHIPPING_PROVIDER=mock
SHIPPING_API_KEY=
SHIPPING_CUSTOMER_CODE=

# ── Gözlemlenebilirlik ───────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── İç servisler ─────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=CHANGE_ME

# Worker rolü: core | media | all  (üretimde ayrı prosesler)
WORKER_ROLE=all
